PORT=3000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,https://tu-sitio.netlify.app
DATA_DIR=./data

# Administrador inicial. Se crea en SQLite durante el primer arranque.
ADMIN_NAME=Administrador BRIANA
ADMIN_EMAIL=tu-correo@gmail.com
ADMIN_WHATSAPP=584121234567
ADMIN_LOGIN_PASSWORD=briana

# Permite que un registro público obtenga rol administrador. No lo publiques.
ADMIN_REGISTRATION_CODE=codigo-largo-y-secreto-para-nuevos-administradores

# Firma y expiración de los tokens JWT.
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-64-caracteres
JWT_EXPIRES_IN=8h

# API de IA (solo backend, nunca en el HTML).
GEMINI_API_KEY=tu-clave-de-gemini

# Gmail: activa verificación en dos pasos y crea una contraseña de aplicación.
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# Secreto largo utilizado para hashear los códigos temporales.
RECOVERY_CODE_PEPPER=cambia-esto-por-un-secreto-largo-y-aleatorio

# WhatsApp Cloud API (Meta). Si no usarás WhatsApp, puedes dejarlos vacíos.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_TEMPLATE_NAME=briana_recovery_code
WHATSAPP_TEMPLATE_LANGUAGE=es